<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">

    <!-- ===== Главный экран ===== -->
    <FrameLayout android:id="@+id/mainScreen" android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_horizontal"
            android:orientation="vertical" android:paddingTop="64dp" android:paddingBottom="40dp">

            <TextView android:id="@+id/statusText" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/status_off" android:textColor="#BFA48E" android:textSize="22sp" android:textStyle="bold" />
            <TextView android:id="@+id/timerText" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:minHeight="22dp" android:textColor="#A88B75" android:textSize="15sp" />

            <Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

            <FrameLayout android:layout_width="320dp" android:layout_height="320dp">
                <View android:id="@+id/pulse1" android:layout_width="230dp" android:layout_height="230dp" android:layout_gravity="center" android:alpha="0" android:background="@drawable/pulse" />
                <View android:id="@+id/pulse2" android:layout_width="230dp" android:layout_height="230dp" android:layout_gravity="center" android:alpha="0" android:background="@drawable/pulse" />
                <FrameLayout android:id="@+id/buttonHolder" android:layout_width="230dp" android:layout_height="230dp" android:layout_gravity="center"
                    android:background="@drawable/ring" android:clickable="true" android:focusable="true">
                    <View android:id="@+id/ringOn" android:layout_width="match_parent" android:layout_height="match_parent" android:alpha="0" android:background="@drawable/ring_on" />
                    <ImageView android:id="@+id/shaurma" android:layout_width="100dp" android:layout_height="160dp" android:layout_gravity="center"
                        android:contentDescription="@string/app_name" android:src="@drawable/shaurma" />
                </FrameLayout>
            </FrameLayout>

            <Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

            <LinearLayout android:id="@+id/subCard" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginStart="20dp" android:layout_marginEnd="20dp" android:background="@drawable/card_bg" android:clickable="true"
                android:focusable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center_vertical" android:orientation="horizontal" android:padding="16dp">
                <ImageView android:layout_width="42dp" android:layout_height="42dp" android:background="@drawable/pin_bg" android:contentDescription="@null" android:padding="10dp" android:src="@drawable/ic_star" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Подписка" android:textColor="#BFA48E" android:textSize="13sp" />
                    <TextView android:id="@+id/subText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Проверяем…" android:textColor="#FFF1DC" android:textSize="17sp" android:textStyle="bold" />
                </LinearLayout>
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:contentDescription="@null" android:src="@drawable/ic_chevron" />
            </LinearLayout>
        </LinearLayout>

        <ImageView android:id="@+id/gear" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="top|end" android:layout_marginTop="40dp"
            android:layout_marginEnd="16dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Настройки" android:padding="12dp" android:src="@drawable/ic_gear" />
    </FrameLayout>

    <!-- ===== Вход ===== -->
    <ScrollView android:id="@+id/loginScreen" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical"
            android:paddingStart="24dp" android:paddingTop="56dp" android:paddingEnd="24dp" android:paddingBottom="32dp">
            <ImageView android:layout_width="170dp" android:layout_height="170dp" android:contentDescription="@string/app_name" android:src="@drawable/ic_launcher_foreground" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Добро пожаловать" android:textColor="#FFF1DC" android:textSize="26sp" android:textStyle="bold" />
            <TextView android:id="@+id/loginSub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center"
                android:text="Войди, чтобы начать" android:textColor="#BFA48E" android:textSize="15sp" />
            <TextView android:id="@+id/loginCode" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp"
                android:background="@drawable/input_bg" android:clickable="true" android:focusable="true" android:gravity="center" android:letterSpacing="0.18" android:paddingTop="18dp" android:paddingBottom="18dp"
                android:text="" android:textColor="#FFF1DC" android:textSize="34sp" android:textStyle="bold" android:visibility="gone" />
            <TextView android:id="@+id/btnTelegram" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="28dp"
                android:background="@drawable/btn_telegram" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
                android:gravity="center" android:text="Войти через Telegram" android:textColor="#FFFFFF" android:textSize="17sp" android:textStyle="bold" />
            <TextView android:id="@+id/loginError" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
                android:gravity="center" android:textColor="#FF8A70" android:textSize="13sp" android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <!-- ===== Настройки ===== -->
    <ScrollView android:id="@+id/settingsScreen" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical"
            android:paddingStart="24dp" android:paddingTop="64dp" android:paddingEnd="24dp" android:paddingBottom="32dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Настройки" android:textColor="#FFF1DC" android:textSize="28sp" android:textStyle="bold" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:background="@drawable/card_bg" android:orientation="vertical" android:padding="18dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:gravity="start"
                android:text="Аккаунт" android:textColor="#BFA48E" android:textSize="13sp" android:textStyle="normal" />
            <TextView android:id="@+id/setUser" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:gravity="start"
                android:text="" android:textColor="#FFF1DC" android:textSize="18sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:gravity="start"
                android:text="Подписка" android:textColor="#BFA48E" android:textSize="13sp" android:textStyle="normal" />
            <TextView android:id="@+id/setSub" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:gravity="start"
                android:text="" android:textColor="#FFF1DC" android:textSize="18sp" android:textStyle="bold" />
            </LinearLayout>
            <TextView android:id="@+id/setBuy" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="20dp"
                android:background="@drawable/btn_primary" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
                android:gravity="center" android:text="Получить подписку в боте" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" />
            <TextView android:id="@+id/setDiag" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="12dp"
                android:background="@drawable/btn_secondary" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
                android:gravity="center" android:text="Диагностика" android:textColor="#FFD9A8" android:textSize="16sp" android:textStyle="bold" />
            <TextView android:id="@+id/setLogout" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="12dp"
                android:background="@drawable/btn_secondary" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
                android:gravity="center" android:text="Выйти из аккаунта" android:textColor="#FFD9A8" android:textSize="16sp" android:textStyle="bold" />
            <TextView android:id="@+id/setBack" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:clickable="true" android:focusable="true"
                android:padding="10dp" android:text="Назад" android:textColor="#BFA48E" android:textSize="15sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
